# Copy to .sops.yaml at repository root and replace EVERY placeholder.
keys:
  - &recovery age1REPLACE_WITH_OFFLINE_RECOVERY_PUBLIC_KEY
  - &neo age1REPLACE_WITH_NEO_PUBLIC_KEY
  - &apoc age1REPLACE_WITH_APOC_PUBLIC_KEY
creation_rules:
  - path_regex: secrets/neo\.yaml$
    key_groups:
      - age: [*recovery, *neo]
  - path_regex: secrets/apoc\.yaml$
    key_groups:
      - age: [*recovery, *apoc]
  - path_regex: secrets/shared\.yaml$
    key_groups:
      - age: [*recovery, *neo, *apoc]
